# Required: Groq API key (get one at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model for the plain-LLM calls (tools such as RTL/TB analysis)
# GROQ_MODEL=llama-3.1-8b-instant

# Optional: Icarus Verilog paths (only needed if iverilog/vvp are NOT on your PATH)
# IVERILOG_PATH=C:\iverilog\bin\iverilog.exe
# VVP_PATH=C:\iverilog\bin\vvp.exe

# Optional: email notification of the debug report (omit entirely to skip email)
# EMAIL_SENDER=you@gmail.com
# EMAIL_PASSWORD=your_gmail_app_password
# EMAIL_RECEIVER=recipient@gmail.com

# ---------------------------------------------------------------------------
# UVM testbench support (only needed for UVM testbenches)
# UVM requires a UVM-capable simulator (VCS, Xcelium, Questa, ...).
# Icarus Verilog and Verilator do NOT support UVM.
#
# Single compile+run command (placeholders: {RTL} {TB} {TEMP_DIR}):
#   UVM_SIM_CMD=vcs -full64 -sverilog -l {TEMP_DIR}/compile.log {RTL} {TB} && simv
#
# Or two-step style (e.g. Questa vlog/vsim):
#   UVM_COMPILE_CMD=vlog -sv -l {TEMP_DIR}/compile.log {RTL} {TB}
#   UVM_RUN_CMD=vsim -c -do "run -all; quit" tb_counter
# ---------------------------------------------------------------------------
