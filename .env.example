# Required: Groq API key (get one at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model for the plain-LLM calls (tools such as RTL/TB analysis)
# GROQ_MODEL=llama-3.1-8b-instant

# Optional: Icarus Verilog paths (only needed if iverilog/vvp are NOT on your PATH)
# IVERILOG_PATH=C:\iverilog\bin\iverilog.exe
# VVP_PATH=C:\iverilog\bin\vvp.exe

# Optional: email notification of the debug report (omit entirely to skip email)
# EMAIL_SENDER=you@gmail.com
# EMAIL_PASSWORD=your_gmail_app_password
# EMAIL_RECEIVER=recipient@gmail.com
